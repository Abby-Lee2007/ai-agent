# ---------------------------------------------------------------------------
# 复制为 .env 并按需填写；也可以直接设置为系统环境变量（本文件仅为示例）
# ---------------------------------------------------------------------------

# LLM 模式：auto（有 Key 用大模型）/ on（强制大模型）/ off（纯规则离线）
FINAGENT_LLM_MODE=auto

# 任何 OpenAI 兼容接口都可以。下面以 DeepSeek 为例
FINAGENT_LLM_API_KEY=
FINAGENT_LLM_BASE_URL=https://api.deepseek.com/v1
FINAGENT_LLM_MODEL=deepseek-chat

# 也可以换成通义千问 / 智谱 GLM / OpenAI：
# FINAGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# FINAGENT_LLM_MODEL=qwen-plus
# FINAGENT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# FINAGENT_LLM_MODEL=glm-4-plus

# 风控阈值（可选）
FINAGENT_CONFIRM_THRESHOLD=1000
FINAGENT_VERIFY_THRESHOLD=20000
FINAGENT_SINGLE_TRANSFER_LIMIT=50000

# 展示开关
FINAGENT_COLOR=1
FINAGENT_SHOW_TRACE=1

